{
  "name": "electron-pma-manager",
  "productName": "electron-pma-manager",
  "private": true,
  "version": "0.0.1",
  "main": "src/electron/electron.js",
  "scripts": {
    "vite": "vite",
    "electron": "NODE_ENV=dev electron .",
    "dev": "vite & NODE_ENV=dev electron .",
    "build": "vue-tsc --noEmit && vite build && npm run build-electron:dist",
    "build-vue": "vue-tsc --noEmit && vite build",
    "build-electron:dir": "electron-builder --dir",
    "build-electron:dist": "electron-builder",
    "build-electron:all": "electron-builder -wl",
    "knex:migrate:make": "knex --knexfile src/database/knexfile.js migrate:make",
    "knex:migrate:latest": "knex --knexfile src/database/knexfile.js migrate:latest",
    "knex:migrate:rollback": "knex --knexfile src/database/knexfile.js migrate:rollback"
  },
  "dependencies": {
    "electron-settings": "^4.0.4",
    "knex": "^3.3.0",
    "sqlite3": "^6.0.1",
    "ssh-config": "^5.3.0",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "pinia": "^4.1.0",
    "sanitize.css": "^13.0.0",
    "sass": "^1.107.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "3.3.11",
    "vue-universal-modal": "^1.1.4",
    "vue3-tabs-component": "^1.4.0"
  },
  "build": {
    "directories": {
      "output": "dist-build",
      "buildResources": "buildResources"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "src/electron/**/*",
      "src/pma/**/*"
    ],
    "extraMetadata": {
      "main": "src/electron/electron.js"
    },
    "appId": "naglfar.electron-pma-manager",
    "mac": {
      "category": "public.app-category.utilities"
    }
  },
  "allowScripts": {
    "sqlite3": true,
    "electron-winstaller": true,
    "core-js": false,
    "cpu-features": true,
    "ssh2": true,
    "@parcel/watcher": false
  }
}
